# Optional official Legistar feed. Defaults to Seattle's public feed.
# Set all three for a different tenant; never use a custom API URL.
LEGISTAR_CLIENT=Seattle
LEGISTAR_CITY=Seattle
LEGISTAR_TIMEZONE=America/Los_Angeles
# Optional OpenRouter provider for on-demand, agenda-item-cited briefings.
# Store the key in Replit Secrets, not this file.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional local database path override
CIVIC_DB_PATH=