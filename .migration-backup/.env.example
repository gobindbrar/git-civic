# The San Francisco public calendar is enabled by default (official site fallback
# when its Events API is unavailable). Set CIVIC_LIVE_ENABLED=0 to disable it.
# Optional additional official Legistar API feed. Defaults to Seattle's public feed.
# Set all three for a different tenant; never use a custom API URL.
LEGISTAR_CLIENT=Seattle
LEGISTAR_CITY=Seattle
LEGISTAR_TIMEZONE=America/Los_Angeles
# Optional OpenRouter provider for on-demand, agenda-item-cited briefings.
# Store the key in Replit Secrets, not this file.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Preferred live AI provider; store the key in Replit Secrets.
CRUSOE_API_KEY=
# Optional API override. The documented Inference endpoint is used if the
# legacy Intelligence endpoint blocks access.
CRUSOE_BASE_URL=https://api.intelligence.crusoecloud.com/v1
# Band is experimental and disabled for the submission demo by default.
BAND_BRIEF_ENABLED=0
# Optional Band External Agent credentials. Set all eight in Replit Secrets.
# The names in Band must be GIT Coordinator, GIT Source Verifier,
# GIT Agenda Analyst, and GIT Civic Critic.
BAND_COORDINATOR_AGENT_ID=
BAND_COORDINATOR_API_KEY=
BAND_SOURCE_VERIFIER_AGENT_ID=
BAND_SOURCE_VERIFIER_API_KEY=
BAND_AGENDA_ANALYST_AGENT_ID=
BAND_AGENDA_ANALYST_API_KEY=
BAND_CIVIC_CRITIC_AGENT_ID=
BAND_CIVIC_CRITIC_API_KEY=
# Optional local database path override
CIVIC_DB_PATH=